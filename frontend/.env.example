# Empty = call the API on the same origin (next.config.ts forwards /api/* to BACKEND_URL).
NEXT_PUBLIC_API_BASE_URL=
# Where next.config.ts forwards /api/* (default http://localhost:8000)
BACKEND_URL=http://localhost:8000
# LIFF app ID from LINE Developers (LINE Login channel > LIFF); empty = no login, dev/demo shop
NEXT_PUBLIC_LIFF_ID=
# LINE OA add-friend link for the "เพิ่มเพื่อน" buttons, e.g. https://line.me/R/ti/p/@xxxx
NEXT_PUBLIC_LINE_ADD_FRIEND_URL=
