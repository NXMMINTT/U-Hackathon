# Database
DATABASE_URL=postgresql+psycopg://uledger:uledger@localhost:5432/uledger

# LINE Messaging API / Login
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Login channel ที่มี LIFF (Basic settings) — ใช้ให้ scripts/sync_public_url.py แก้ Endpoint URL ของ LIFF อัตโนมัติ
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LIFF_ID=
# dev/เดโมเท่านั้น (ใช้เมื่อไม่ได้ตั้ง LIFF_ID): ให้ dashboard แสดงร้านของ LINE user นี้แทนร้านตัวอย่าง
DASHBOARD_LINE_USER_ID=

# KKU IntelSphere (LINE bot แยกรายการ/สลิป/เสียง + U-Bot, voice, knowledge)
# ขอ key ได้จาก gen.ai.kku.ac.th/chat
KKU_BASE_URL=https://gen.ai.kku.ac.th/api/v1
KKU_API_KEY=
KKU_MODEL=gemini-3.5-flash-lite

# ElevenLabs (voice reply)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3
ENABLE_VOICE_REPLY=false

# Auth
JWT_SECRET=change-me

# Misc
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
MACRO_DATA_MODE=mock
