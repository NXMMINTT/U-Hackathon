# Database
DATABASE_URL=postgresql+psycopg://uledger:uledger@localhost:5432/uledger

# LINE Messaging API / Login
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LIFF_ID=

# Google Gemini (used directly by gemini_service.py to parse LINE slips/voice)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Gemini via KKU IntelSphere (OpenAI-compatible — used by U-Bot / Market Radar / daily knowledge)
GEMINI_BASE_URL=https://gen.ai.kku.ac.th/api/v1
UBOT_GEMINI_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
UBOT_GEMINI_MODEL=gemini-3.5-flash-lite

# ElevenLabs (voice reply)
# Free tier ไม่สามารถเรียก "library voice" ผ่าน API ได้ (ขึ้น 402)
# ต้องใช้ voice ID จากแท็บ "My Voices" ในบัญชีตัวเอง (Voices > My Voices > เลือกเสียง > copy Voice ID)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_my_voices_voice_id_here
ELEVENLABS_MODEL_ID=eleven_v3
ENABLE_VOICE_REPLY=false

# Auth
JWT_SECRET=change-me

# Misc
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
MACRO_DATA_MODE=mock
