# Database
DATABASE_URL=postgresql+psycopg://uledger:uledger@localhost:5432/uledger

# LINE Messaging API / Login
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LIFF_ID=

# Google Gemini (LINE bot: แยกรายการจากข้อความ/สลิป/เสียง)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# KKU IntelSphere (U-Bot, voice, knowledge — /api/ubot, /api/voice, /api/knowledge)
# ขอ key ได้จาก gen.ai.kku.ac.th/chat
KKU_BASE_URL=https://gen.ai.kku.ac.th/api/v1
KKU_API_KEY=
KKU_MODEL=gemini-3.5-flash-lite

# ElevenLabs (voice reply)
# ElevenLabs free tier ไม่สามารถเรียก "library voice" ผ่าน API ได้ (ขึ้น 402)
# ต้องใช้ voice ID จากแท็บ "My Voices" ในบัญชีตัวเอง (Voices > My Voices > เลือกเสียง > copy Voice ID)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3
ENABLE_VOICE_REPLY=false

# Auth
JWT_SECRET=change-me

# Misc
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
MACRO_DATA_MODE=mock
